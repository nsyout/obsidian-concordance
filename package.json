{
  "name": "obsidian-concordance",
  "version": "0.2.0",
  "description": "Generate safe Markdown indexes from folders, tags, properties, and filename patterns in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{css,js,json,jsonc,mjs,ts,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{css,js,json,jsonc,mjs,ts,yaml,yml}\"",
    "deps:audit": "npm audit --audit-level=moderate --omit=dev",
    "deps:outdated": "npm outdated",
    "check:api-floor": "node scripts/check-api-floor.mjs",
    "qa": "scripts/local-qa.sh",
    "security": "scripts/local-security.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "nsyout",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "~1.13.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
